{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "shared", "preview", "supabase/functions", "vite.config.ts", "vite.preview.config.ts", "vite.101-preview.config.ts", "vite.gem-keep-preview.config.ts", "vite.maths-preview.config.ts", "vite.training-preview.config.ts", "vite.monsters-preview.config.ts"],
  "exclude": ["supabase/functions/*/index.ts"]
}
