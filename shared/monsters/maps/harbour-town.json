g Centre.\nWalk in the long grass up north to find wild monsters. Throw a ball to catch them!\nGood luck!"}]},{"id":6,"name":"Fisher","type":"person","x":304,"y":224,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"sprite","type":"int","value":111},{"name":"facing","type":"string","value":"left"},{"name":"text","type":"string","value":"The Minnowus here are so quick. I swear one swam off with my sandwich."}]},{"id":7,"name":"Monster box","type":"box","x":48,"y":224,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"text","type":"string","value":"This is your Monster box. It keeps the monsters that do not fit in your team of six.\nYour box holds {box} monsters. Opening the box is coming soon!"}]},{"id":8,"name":"Monster book","type":"book","x":32,"y":224,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"text","type":"string","value":"This is the Monster book. It will list every monster you find, and its type.\nThe book is coming soon!"}]},{"id":9,"name":"to-bush-left","type":"warp","x":176,"y":0,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"kauri-bush"},{"name":"toX","type":"int","value":11},{"name":"toY","type":"int","value":18},{"name":"facing","type":"string","value":"up"}]},{"id":10,"name":"to-bush-right","type":"warp","x":192,"y":0,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"kauri-bush"},{"name":"toX","type":"int","value":12},{"name":"toY","type":"int","value":18},{"name":"facing","type":"string","value":"up"}]},{"id":11,"name":"to-healing-centre","type":"warp","x":96,"y":128,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"healing-centre"},{"name":"toX","type":"int","value":5},{"name":"toY","type":"int","value":5},{"name":"facing","type":"string","value":"up"}]},{"id":12,"name":"start","type":"spot","x":176,"y":240,"width":