{
  "name": "school-games-hub",
  "private": true,
  "version": "0.1.0",
  "description": "A chess and checkers website for Year 4-6 students",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "build:functions": "node scripts/build-functions.mjs",
    "functions:serve": "supabase functions serve --no-verify-jwt",
    "space:sim": "node scripts/space-sim.mjs",
    "space:preview": "vite build --config vite.preview.config.ts",
    "101:sim": "node scripts/101-sim.mjs",
    "power-clash:sim": "node scripts/power-clash-sim.mjs",
    "101:preview": "vite build --config vite.101-preview.config.ts",
    "power-clash:preview": "vite build --config vite.power-clash-preview.config.ts",
    "gem-keep:preview": "vite build --config vite.gem-keep-preview.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bleedingrobot/school-games-hub.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "chess.js": "1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "rolldown": "1.2.14",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
