{
  "name": "school-games-hub",
  "private": true,
  "version": "0.1.0",
  "description": "A chess and checkers website for Year 4-6 students",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:changed": "TESTS=all vitest run --changed --passWithNoTests",
    "test:logic": "vitest run --project logic",
    "test:slow": "TESTS=slow vitest run",
    "test:all": "TESTS=all vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:all && npm run build",
    "check:quick": "npm run typecheck && npm test",
    "check:all": "npm run check",
    "test:db": "supabase test db supabase/tests/database",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "build:functions": "node scripts/build-functions.mjs",
    "functions:serve": "supabase functions serve --no-verify-jwt",
    "space:sim": "node scripts/space-sim.mjs",
    "marble:determinism": "node scripts/marble-determinism.mjs",
    "marble:sim": "node scripts/marble-sim.mjs",
    "marble:preview": "vite build --config vite.marble-preview.config.ts",
    "marble:single": "MARBLE_INLINE=1 vite build --config vite.marble-preview.config.ts && node scripts/inline-monsters-preview.mjs dist-preview-marble marble-rush-test-page.html",
    "monsters:sim": "node scripts/monsters-sim.mjs",
    "space:preview": "vite build --config vite.preview.config.ts",
    "101:sim": "node scripts/101-sim.mjs",
    "power-clash:sim": "node scripts/power-clash-sim.mjs",
    "clans:sim": "node scripts/clans-sim.mjs",
    "101:preview": "vite build --config vite.101-preview.config.ts",
    "gem-keep:preview": "vite build --config vite.gem-keep-preview.config.ts",
    "bond-match:preview": "vite build --config vite.bond-match-preview.config.ts",
    "maths:preview": "vite build --config vite.maths-preview.config.ts",
    "training:preview": "vite build --config vite.training-preview.config.ts",
    "monsters:preview": "vite build --config vite.monsters-preview.config.ts",
    "monsters:single": "MONSTERS_INLINE=1 vite build --config vite.monsters-preview.config.ts && node scripts/inline-monsters-preview.mjs",
    "power-clash:preview": "vite build --config vite.power-clash-preview.config.ts",
    "lord:sim": "node scripts/lord-sim.mjs",
    "lord:preview": "vite build --config vite.lord-preview.config.ts",
    "clans:preview": "vite build --config vite.clans-preview.config.ts",
    "clans:frame": "vite build --config vite.clans-frame.config.ts",
    "clans:tryout": "vite build --config vite.clans-tryout.config.ts",
    "home:preview": "vite build --config vite.home-preview.config.ts",
    "home:single": "HOME_INLINE=1 vite build --config vite.home-preview.config.ts && node scripts/inline-monsters-preview.mjs dist-preview-home home-themes-test-page.html",
    "mine:preview": "vite build --config vite.mine-preview.config.ts",
    "mine:single": "MINE_INLINE=1 vite build --config vite.mine-preview.config.ts && node scripts/inline-monsters-preview.mjs dist-preview-mine mine-runner-test-page.html",
    "mine:determinism": "node scripts/mine-determinism.mjs",
    "mine:sim": "node scripts/mine-sim.mjs",
    "subitising:preview": "vite build --config vite.subitising-preview.config.ts",
    "archery:sim": "node scripts/archery-sim.mjs",
    "trader:sim": "node scripts/trader-sim.mjs",
    "trader:preview": "vite build --config vite.trader-preview.config.ts",
    "archery:preview": "vite build --config vite.archery-preview.config.ts",
    "archery:single": "ARCHERY_INLINE=1 vite build --config vite.archery-preview.config.ts && node scripts/inline-monsters-preview.mjs dist-preview-archery archery-test-page.html",
    "archery:determinism": "node scripts/archery-determinism.mjs",
    "kingdom:sim": "node scripts/kingdom-sim.mjs",
    "kingdom:preview": "vite build --config vite.kingdom-preview.config.ts",
    "diamond:sim": "node scripts/diamond-sim.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bleedingrobot/school-games-hub.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "chess.js": "1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "stockfish": "19.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "rolldown": "1.2.14",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
